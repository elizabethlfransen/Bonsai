{
  "permissions": {
    "default": {
      "read": true,
      "write": true,
      "net": [
        "launchermeta.mojang.com",
        "maven.neoforged.net",
        "repo.mumfrey.com",
        "maven.quiltmc.org",
        "files.minecraftforge.net",
        "maven.fabricmc.net",
        "maven.minecraftforge.net"
      ],
      "run": true,
      "env": true
    }
  },
  "tasks": {
    "dev": "deno run -P=default src/main.ts",
    "compile": "deno compile -P=default --output bonsai src/main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "fast-xml-parser": "npm:fast-xml-parser@^5.10.1",
    "yargs": "npm:yargs@^17"
  }
}
